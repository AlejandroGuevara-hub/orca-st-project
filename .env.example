# Archivo de referencia: copiar a .env y completar valores locales.
# No incluir secretos reales en este archivo ni commitear .env.

# Aplicación
NODE_ENV=development
APP_NAME=orca-st-project
APP_PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/orca_st_project

# Autenticación
AUTH_SECRET=change-me
AUTH_TOKEN_TTL=3600

# IA (si aplica)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=2048

# Servicios externos
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
